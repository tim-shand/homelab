# ========================================================================================================= #
# Proxmox: Cluster Options
# Description:
# - Manages Proxmox VE Cluster Datacenter options.
# https://registry.terraform.io/providers/bpg/proxmox/latest/docs/resources/cluster_options
# ========================================================================================================= #

# Proxmox: Cluster Configuration ------------------------------------------- #
resource "proxmox_cluster_options" "main" {
  description = var.pve_cluster_options.description # Shown in the web-interface datacenter notes panel.
  language    = var.pve_cluster_options.language
  keyboard    = var.pve_cluster_options.keyboard
  mac_prefix  = var.pve_cluster_options.mac_prefix # Prefix for autogenerated MAC addresses. "BC:24:11" is default for Proxmox.
  next_id = {
    lower = var.pve_cluster_options.next_id.lower # The ranges for the next free VM ID auto-selection pool.
    upper = var.pve_cluster_options.next_id.upper
  }
}

# Proxmox: Node Details ------------------------------------------- #
resource "proxmox_node_config" "main" {
  for_each    = toset(data.proxmox_virtual_environment_nodes.pve_nodes.names)
  node_name   = each.value
  description = "[Managed by Terraform] Proxmox Node (${each.value})"
}

# Proxmox: Resource Pools ------------------------------------------- #
resource "proxmox_virtual_environment_pool" "main" {
  for_each = var.pve_pools
  pool_id  = each.key
  comment  = each.value
}

# ============================================================================================================ #
# Proxmox: Identity and Access Management
# Description:
# - Manages Proxmox VE User, Groups and Permissions.
# - Notes: https://registry.terraform.io/providers/bpg/proxmox/latest/docs/resources/virtual_environment_group
# - Export Tokens: terraform -chdir=./terraform/platform/proxmox-cluster output -json pve_users_sensitive | jq -r '.'
# ============================================================================================================ #

# Proxmox: Groups --------------------------------------------------- #
module "pve_iam_group_acls" {
  source        = "../../modules/pve-iam-group-acls"
  for_each      = local.pve_iam_groups_enabled
  group_name    = each.key
  group_comment = each.value.comment
  group_acls    = each.value.acls
}

# Proxmox: Service Account Users --------------------------------------------------- #
module "pve_iam_users_svc" {
  source                = "../../modules/pve-iam-users-svc"
  for_each              = local.pve_iam_users_svc_enabled
  user_id               = "${each.key}@${each.value.realm}"
  user_comment          = each.value.comment
  user_password_enabled = each.value.password_enabled
  user_token_enabled    = each.value.token_enabled
  user_groups           = each.value.groups
  depends_on            = [module.pve_iam_group_acls]
}
